DJANGO_SECRET_KEY=replace-with-a-long-random-value
DJANGO_DEBUG=false
DJANGO_ALLOWED_HOSTS=app.example.com
DJANGO_CSRF_TRUSTED_ORIGINS=https://app.example.com
DJANGO_SECURE_SSL_REDIRECT=true
DATABASE_URL=postgresql://user:password@host:5432/taller_pro
DJANGO_SECURE_HSTS_SECONDS=31536000
DJANGO_SECURE_HSTS_PRELOAD=false
SITE_URL=https://app.example.com
TRIAL_DAYS=14
REGISTRATION_RATE_LIMIT=5
REGISTRATION_RATE_LIMIT_WINDOW=3600
DJANGO_CACHE_BACKEND=django.core.cache.backends.filebased.FileBasedCache
DJANGO_CACHE_LOCATION=/tmp/taller-pro-cache
DEFAULT_FROM_EMAIL="Taller Pro <no-reply@example.com>"
EMAIL_BACKEND=django.core.mail.backends.smtp.EmailBackend
EMAIL_HOST=smtp.example.com
EMAIL_PORT=587
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
EMAIL_USE_TLS=true
EMAIL_TIMEOUT=10
SERVER_EMAIL="Taller Pro <errores@example.com>"
TRUST_X_FORWARDED_FOR=true
LOGIN_RATE_LIMIT=10
PASSWORD_RESET_RATE_LIMIT=5
ACTIVATION_RESEND_RATE_LIMIT=5
AUTH_RATE_LIMIT_WINDOW=3600
PASSWORD_RESET_TIMEOUT=3600
LEGAL_DOCUMENT_VERSION=2026-08-02
LEGAL_ENTITY_NAME="Taller Pro"
LEGAL_ENTITY_ADDRESS="Dirección legal completa"
LEGAL_CONTACT_EMAIL=contacto@example.com
LEGAL_JURISDICTION=Brasil
PUBLIC_PLAN_PRICE_LABEL="US$ 19 por mes"
ACCOUNT_DELETION_GRACE_DAYS=7
PADDLE_ENABLED=true
PADDLE_ENVIRONMENT=sandbox
PADDLE_CLIENT_TOKEN=test_replace_me
PADDLE_API_KEY=pdl_sdbx_apikey_replace_me
PADDLE_WEBHOOK_SECRET=pdl_ntfset_replace_me
PADDLE_PROFESSIONAL_PRICE_ID=pri_replace_me
PADDLE_API_TIMEOUT=10
PADDLE_WEBHOOK_TOLERANCE=300
BILLING_PAST_DUE_GRACE_DAYS=3
SENTRY_DSN=
